{
  "expo": {
    "name": "crime-map-mobile",
    "slug": "crime-map-mobile-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28eb4879-ab36-4b9d-8108-efe05b398e19"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crimemapmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.r4lphbryan.crimemapmobile"
    },
    "android": {
      "package": "com.r4lphbryan.crimemapmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "@rnmapbox/maps", "expo-font", "expo-updates"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28eb4879-ab36-4b9d-8108-efe05b398e19"
      }
    },
    "owner": "r4lphbryan"
  }
}
